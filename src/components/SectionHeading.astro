---
interface Props {
  number: string;
  label: string;
  title?: string;
}

const { number, label, title } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow"><span>{number}</span><span class="eyebrow-rule" aria-hidden="true"></span>{label}</p>
  {title && <h2>{title}</h2>}
</div>
