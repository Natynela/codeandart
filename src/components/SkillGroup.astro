---
import type { SkillGroup as SkillGroupData } from "../data/skills";

interface Props {
  group: SkillGroupData;
  index: number;
}

const { group, index } = Astro.props;
---

<article class="skill-group">
  <span class="skill-index">{String(index + 1).padStart(2, "0")}</span>
  <h3>{group.title}</h3>
  <ul>
    {group.skills.map((skill) => <li>{skill}</li>)}
  </ul>
</article>
