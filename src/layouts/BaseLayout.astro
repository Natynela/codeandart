---
import "../styles/global.css";
import { profile } from "../data/profile";
import { translations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale } = Astro.props;
const t = translations[locale];
const {
  title = `${profile.name} — ${t.title}`,
  description = t.description,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#F5F2EA" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_CA" : locale === "ro" ? "ro_RO" : "en_CA"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={profile.name} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {Astro.site && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
        <link rel="alternate" hreflang="fr" href={new URL(`${import.meta.env.BASE_URL}fr/`, Astro.site)} />
        <link rel="alternate" hreflang="ro" href={new URL(`${import.meta.env.BASE_URL}ro/`, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script src="../scripts/menu.js"></script>
  </body>
</html>
